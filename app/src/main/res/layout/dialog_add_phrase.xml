<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_card_rounded">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Classroom Phrase"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/navy_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Store a new bilingual phrase for offline teaching"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <!-- Hindi Text Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hindi Text (हिन्दी वाक्य):"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/et_dialog_hindi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_pill_outline"
        android:hint="e.g. शांत रहिए"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Santhali Ol Chiki Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Santhali Ol Chiki (ᱚᱞ ᱪᱤᱠᱤ):"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/et_dialog_olchiki"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_pill_outline"
        android:hint="e.g. ᱛᱷᱤᱨ ᱛᱟᱦᱮᱸᱱ ᱢᱮ (Auto-transliterated if empty)"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Roman Transliteration Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Roman Pronunciation (उच्चारण):"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/et_dialog_roman"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_pill_outline"
        android:hint="e.g. Thir tahen me"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Category Spinner/Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Category:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <EditText
        android:id="@+id/et_dialog_category"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_pill_outline"
        android:hint="Classroom Commands"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Dialog Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:backgroundTint="#F1F5F9"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_dialog_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Save Phrase"
            android:textColor="@color/white"
            android:backgroundTint="@color/navy_primary" />
    </LinearLayout>

</LinearLayout>
