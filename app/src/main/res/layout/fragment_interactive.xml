<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Interactive Pedagogy (ᱠᱟᱹᱢᱤᱦᱚᱨᱟ)"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose an offline assessment or flashcard module below"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="20dp" />

        <!-- 2 Big Modules matching Sketch 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Module 1: Worksheet and Assessment matching sketch box 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_worksheets"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="📝"
                        android:textSize="32sp"
                        android:gravity="center"
                        android:background="#EFF6FF"
                        android:layout_marginBottom="12dp" />

                    <!-- Title matching Sketch 4: "Worksheet and Assessment" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Worksheet and\nAssessment"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy_primary"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MCQs, Matching, Fill-in-blanks &amp; Pictures"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                    <Button
                        android:id="@+id/btn_launch_worksheet"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Start Quiz ➔"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/navy_accent"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Module 2: Flash Cards matching sketch box 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_flashcards"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:text="🎴"
                        android:textSize="32sp"
                        android:gravity="center"
                        android:background="#FEF3C7"
                        android:layout_marginBottom="12dp" />

                    <!-- Title matching Sketch 4: "Flash Cards" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Flash\nCards"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/navy_primary"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Image + Hindi (front) &amp; Ol Chiki + Audio (back)"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:layout_marginTop="6dp" />

                    <Button
                        android:id="@+id/btn_launch_flashcards"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Practice ➔"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/action_repeat"
                        android:layout_marginTop="10dp"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
