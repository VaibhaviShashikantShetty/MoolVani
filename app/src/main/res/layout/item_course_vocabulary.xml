<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tv_vocab_emoji"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="🐘"
            android:textSize="22sp"
            android:gravity="center"
            android:background="#F8FAFC" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_vocab_hindi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="हाथी"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/navy_primary" />

            <TextView
                android:id="@+id/tv_vocab_olchiki"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ᱦᱟᱹᱛᱤ"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/navy_accent"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_vocab_roman"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hati • Elephant"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Tap to speak item -->
        <ImageButton
            android:id="@+id/btn_vocab_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_button"
            android:src="@drawable/ic_volume_up"
            android:contentDescription="Play Item Audio"
            app:tint="@color/white" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
